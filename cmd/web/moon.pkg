import {
  "cheng-jun56/pop3" @lib,
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "run",
        "session_open",
        "session_close",
        "session_feed",
        "session_finish",
        "session_issue",
        "session_continue",
        "session_phase",
      ],
      "format": "esm",
    },
  },
)
